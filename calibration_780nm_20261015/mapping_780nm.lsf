switchtolayout;
selectall;
delete;

iteration_limit=20;
addvarfdtd;
set("x", 0);
set("y", 0);
set("x span", 0.3e-6);
set("y span", 8e-6);
set("z span", 5*0.22e-6);
set('mesh accuracy', 7);
set('simulation time',500e-15);
set('auto shutoff min',1e-7);
set('x min bc','Periodic');
set('x max bc','Periodic');

set('background material', '<Object defined dielectric>');
set('index', 1.0);
set("z", 0);
if (haveproperty("y0")) { set("y0", -3.0e-6); }
addrect;
set("name", "propagation");
set('material', 'Si (Silicon) - Palik');
set("x", 0);
set("y", 0);
set("x span", 15e-6);
set("y span", 10e-6);
set("z span", 0.22e-6);
set("z", 0);

addrect;
set('name','oxide_substrate');
set('material','SiO2 (Glass) - Palik');
set('x span',15e-6);
set('y span',10e-6);
set('z span',2e-6);
set('z',-1.11e-6);
addpower;
set("name", "monitor");
set("monitor type", "linear x");
set("x span",0.3e-6);
set("x", 0);
set("z", 0);
set("y", 2.5e-6);

addpower;
set("name", "monitor_2");
set("monitor type", "linear x");
set("x span",0.3e-6);
set("x", 0);
set("y", -2.5e-6);
set("z", 0);

addrect;
set("name", "hope");
set("material", "SiO2 (Glass) - Palik");
set("x span", 0.15e-6);
set("y span", 0.1e-6);
set("z span", 0.22e-6);
set("x", -0.5*15*1e-6);
set("y", 0);
set("z", 0);

addplane;
set("name", "plane_wave");
set("x", 0);
set("x span",15e-6);
set("y", -3.5e-6);
set("z", 0);
set('override global source settings',1);
set('set wavelength',1);
set('wavelength start',0.78e-6);
set('wavelength stop', 0.78e-6);

function complex_transfer() {
    h_out = pinch(getdata('monitor','Hz'));
    h_in = pinch(getdata('monitor_2','Hz'));
    xx = pinch(getdata('monitor','x'));
    ii = find(abs(xx)<1.95e-6);
    return sum(h_out(ii)*conj(h_in(ii)))/sum(abs(h_in(ii))^2);
}

function add_rect_group(original_rectangle_name, group_name) {
    addgroup;
    set("name", group_name+"_1");

    select(original_rectangle_name);
    x_original = get("x");
    y_original = get("y");
    width = get("x span");
    height = get("y span");
    material = get("material");

    num_copies = 50.0;
    spacing = 0.3e-6;
    zspan = 0.22e-6;

    for (i = 1:num_copies) {
        x_new = x_original + i*spacing;
        addrect;
        set("name", original_rectangle_name + "_" + num2str(i));
        set("x", x_new);
        set("x span", width);
        set("y", y_original);
        set("y span", height);
        set("z span",zspan);
        set("z", 0);
        set("material", material);
        addtogroup(group_name+"_1");
    }
}

setglobalmonitor('use source limits',true);
setglobalmonitor('frequency points',1);
select('plane_wave');
set('injection axis','y-axis');
set('direction','Forward');
# varFDTD determines source polarization from its selected slab mode.
set('set time domain',1);
set('frequency',299792458/780e-9);
set('pulselength',20e-15);
set('offset',60e-15);
select('hope'); set('enabled',0);
save('mapping_780nm');
run;
sample_frequency_hz = getdata('monitor','f');
t0 = complex_transfer();
write('complex_transmission.txt','length_um,re,im,abs_transfer');
write('complex_transmission.txt','0,1,0,'+num2str(abs(t0)));
switchtolayout;
select('hope'); set('enabled',1);
for (j=1:iteration_limit) {
    add_rect_group('hope','group');
    select('hope'); set('enabled',0);
    run;
    tj = complex_transfer();
    relative_t = tj/t0;
    write('complex_transmission.txt',num2str(j*0.1)+','+num2str(real(relative_t))+','+num2str(imag(relative_t))+','+num2str(abs(tj)));
    switchtolayout;
    select('group_1'); delete;
    select('hope'); set('enabled',1);
    set('y span',(j+1)*0.1e-6);
}
save('mapping_780nm');

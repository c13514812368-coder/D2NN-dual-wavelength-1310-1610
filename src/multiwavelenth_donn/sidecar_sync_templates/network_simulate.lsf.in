# Managed from YAML by scripts/sync_base_lsf.py.
# Edit the paired YAML, then re-run the sync helper. The variable block below is auto-managed.
# >>> AUTO-SYNC VARS BEGIN
use_var_fdtd = {{use_var_fdtd}};
use_taper = {{use_taper}};
local_map_enabled = {{local_map_enabled}};
multi_wavelength = {{multi_wavelength}};

input_ys_m = {{input_ys_m}};
output_ys_m = {{output_ys_m}};
monitor_positions_m = {{monitor_positions_m}};

background_material_name = {{background_material_name}};
background_material_index = {{background_material_index}};
background_set_index = {{background_set_index}};

propagation_material_name = {{propagation_material_name}};
propagation_material_index = {{propagation_material_index}};
propagation_set_index = {{propagation_set_index}};

sub_material_name = {{sub_material_name}};
sub_material_index = {{sub_material_index}};
sub_set_index = {{sub_set_index}};

lam_start_m = {{lam_start_m}};
lam_stop_m = {{lam_stop_m}};
wl_points = {{wl_points}};
mesh_accuracy = {{mesh_accuracy}};

fdtd_x_span_m = {{fdtd_x_span_m}};
fdtd_y_span_m = {{fdtd_y_span_m}};
fdtd_z_span_m = {{fdtd_z_span_m}};
fdtd_center_x_m = {{fdtd_center_x_m}};
simulation_time_s = {{simulation_time_s}};

prop_x_span_m = {{prop_x_span_m}};
prop_center_x_m = {{prop_center_x_m}};
prop_y_span_m = {{prop_y_span_m}};
prop_z_span_m = {{prop_z_span_m}};
sub_x_span_m = {{sub_x_span_m}};
sub_center_x_m = {{sub_center_x_m}};
sub_y_span_m = {{sub_y_span_m}};
sub_z_span_m = {{sub_z_span_m}};
sub_center_z_m = {{sub_center_z_m}};

monitor_y_span_m = {{monitor_y_span_m}};
x_in_center_m = {{x_in_center_m}};
x_out_center_m = {{x_out_center_m}};
local_map_left_pad_m = {{local_map_left_pad_m}};
local_map_right_pad_m = {{local_map_right_pad_m}};
wg_len_m = {{wg_len_m}};
wg_width_m = {{wg_width_m}};
source_y_span_m = {{source_y_span_m}};
monitor_port_y_span_m = {{monitor_port_y_span_m}};

input_taper_len_m = {{input_taper_len_m}};
output_taper_len_m = {{output_taper_len_m}};
input_taper_wide_m = {{input_taper_wide_m}};
output_taper_wide_m = {{output_taper_wide_m}};
taper_narrow_m = {{taper_narrow_m}};
taper_lead_len_m = {{taper_lead_len_m}};
# <<< AUTO-SYNC VARS END

switchtolayout;

if (use_var_fdtd) {
    addvarfdtd;
} else {
    addfdtd;
    set('dimension', '2D');
}

set('background material', background_material_name);
if (background_set_index) { set('index', background_material_index); }
set('x min bc','PML');
set('x max bc','PML');
set('y min bc','PML');
set('y max bc','PML');
set('z min bc','PML');
set('z max bc','PML');
set('x span', fdtd_x_span_m);
set('y span', fdtd_y_span_m);
set('z span', fdtd_z_span_m);
set('x', fdtd_center_x_m);
set('y', 0);
set('z', 0);
set('mesh accuracy', mesh_accuracy);
set('simulation time', simulation_time_s);

setglobalmonitor('use source limits', true);
setglobalmonitor('frequency points', wl_points);

addrect;
set('name', 'propagation');
set('material', propagation_material_name);
if (propagation_set_index) { set('index', propagation_material_index); }
set('x span', prop_x_span_m);
set('y span', prop_y_span_m);
set('z span', prop_z_span_m);
set('x', 0);
set('y', 0);
set('z', 0);

addrect;
set('name', 'sub');
set('material', sub_material_name);
if (sub_set_index) { set('index', sub_material_index); }
set('x span', sub_x_span_m);
set('y span', sub_y_span_m);
set('z span', sub_z_span_m);
set('x', 0);
set('y', 0);
set('z', sub_center_z_m);

addprofile;
set('name', 'global_fields');
set('monitor type', '2D Z-normal');
set('x span', fdtd_x_span_m);
set('y span', fdtd_y_span_m);
set('x', fdtd_center_x_m);
set('y', 0);
set('z', 0);

addindex;
set('name', 'global_fields_index');
set('monitor type', '2D Z-normal');
set('x span', fdtd_x_span_m);
set('y span', fdtd_y_span_m);
set('x', fdtd_center_x_m);
set('y', 0);
set('z', 0);

for (monitor_idx = 1:length(monitor_positions_m)) {
    addpower;
    set('name', "monitor"+num2str(monitor_idx-1));
    set('monitor type', '2D X-normal');
    set('y span', monitor_y_span_m);
    set('x', monitor_positions_m(monitor_idx));
    set('z', 0);
}

if (use_taper) {
    for (i = 1:length(input_ys_m)) {
        y_m = input_ys_m(i);
        taper_center_x = x_in_center_m - 0.5*input_taper_len_m;
        lead_center_x = (x_in_center_m - input_taper_len_m) - 0.5*taper_lead_len_m;
        pts = [-0.5*input_taper_len_m, -0.5*input_taper_wide_m;
               -0.5*input_taper_len_m,  0.5*input_taper_wide_m;
                0.5*input_taper_len_m,  0.5*taper_narrow_m;
                0.5*input_taper_len_m, -0.5*taper_narrow_m];

        addrect;
        set('name', "in_lead"+num2str(i-1));
        set('material', propagation_material_name);
        if (propagation_set_index) { set('index', propagation_material_index); }
        set('x span', taper_lead_len_m);
        set('y span', input_taper_wide_m);
        set('z span', prop_z_span_m);
        set('x', lead_center_x);
        set('y', y_m);
        set('z', 0);

        addpoly;
        set('name', "taper_in"+num2str(i-1));
        set('material', propagation_material_name);
        if (propagation_set_index) { set('index', propagation_material_index); }
        set('x', taper_center_x);
        set('y', y_m);
        set('z span', prop_z_span_m);
        set('z', 0);
        set('vertices', pts);

        addmodesource;
        set('name', "mode_src"+num2str(i-1));
        set('injection axis','x');
        set('x', lead_center_x);
        set('y', y_m);
        set('y span', source_y_span_m);
        set('wavelength start', lam_start_m);
        set('wavelength stop', lam_stop_m);
        if (multi_wavelength) {
            if (haveproperty('multifrequency mode calculation')) { set('multifrequency mode calculation', true); }
            if (haveproperty('frequency points')) { set('frequency points', wl_points); }
        }
    }

    for (i = 1:length(output_ys_m)) {
        y_m = output_ys_m(i);
        taper_center_x = x_out_center_m + 0.5*output_taper_len_m;
        lead_center_x = (x_out_center_m + output_taper_len_m) + 0.5*taper_lead_len_m;
        pts = [-0.5*output_taper_len_m, -0.5*taper_narrow_m;
               -0.5*output_taper_len_m,  0.5*taper_narrow_m;
                0.5*output_taper_len_m,  0.5*output_taper_wide_m;
                0.5*output_taper_len_m, -0.5*output_taper_wide_m];
        p_name = "P"+num2str(i-1);
        modeexp_name = "modeExp_"+num2str(i-1);

        addpoly;
        set('name', "taper_out"+num2str(i-1));
        set('material', sub_material_name);
        if (sub_set_index) { set('index', sub_material_index); }
        set('x', taper_center_x);
        set('y', y_m);
        set('z span', prop_z_span_m);
        set('z', 0);
        set('vertices', pts);

        addrect;
        set('name', "out_lead"+num2str(i-1));
        set('material', propagation_material_name);
        if (propagation_set_index) { set('index', propagation_material_index); }
        set('x span', taper_lead_len_m);
        set('y span', output_taper_wide_m);
        set('z span', prop_z_span_m);
        set('x', lead_center_x);
        set('y', y_m);
        set('z', 0);

        addpower;
        set('name', p_name);
        set('monitor type','2D X-normal');
        set('x', lead_center_x);
        set('y', y_m);
        set('y span', monitor_port_y_span_m);
        set('z', 0);

        addmodeexpansion;
        set('name', modeexp_name);
        set('monitor type', 'linear Y');
        setexpansion(modeexp_name, p_name);
        set('x', lead_center_x);
        set('y', y_m);
        set('y span', monitor_port_y_span_m);
        set('mode selection', 'fundamental mode');
        if (multi_wavelength) {
            if (haveproperty('override global monitor settings')) { set('override global monitor settings', true); }
            if (haveproperty('use source limits')) { set('use source limits', true); }
            if (haveproperty('frequency points')) { set('frequency points', wl_points); }
        }
        set('z', 0);
    }
} else {
    for (i = 1:length(input_ys_m)) {
        y_m = input_ys_m(i);
        source_x_m = x_in_center_m - 0.6*wg_len_m;

        addrect;
        set('name', "input_wg"+num2str(i-1));
        set('material', propagation_material_name);
        if (propagation_set_index) { set('index', propagation_material_index); }
        set('x span', wg_len_m);
        set('y span', wg_width_m);
        set('z span', prop_z_span_m);
        set('x', x_in_center_m);
        set('y', y_m);
        set('z', 0);

        addmodesource;
        set('name', "mode_src"+num2str(i-1));
        set('injection axis','x');
        set('x', source_x_m);
        set('y', y_m);
        set('y span', source_y_span_m);
        set('wavelength start', lam_start_m);
        set('wavelength stop', lam_stop_m);
        if (multi_wavelength) {
            if (haveproperty('multifrequency mode calculation')) { set('multifrequency mode calculation', true); }
            if (haveproperty('frequency points')) { set('frequency points', wl_points); }
        }
    }

    for (i = 1:length(output_ys_m)) {
        y_m = output_ys_m(i);
        monitor_x_m = x_out_center_m + 0.4*wg_len_m;
        p_name = "P"+num2str(i-1);
        modeexp_name = "modeExp_"+num2str(i-1);

        addrect;
        set('name', "output_wg"+num2str(i-1));
        set('material', propagation_material_name);
        if (propagation_set_index) { set('index', propagation_material_index); }
        set('x span', wg_len_m);
        set('y span', wg_width_m);
        set('z span', prop_z_span_m);
        set('x', x_out_center_m);
        set('y', y_m);
        set('z', 0);

        addpower;
        set('name', p_name);
        set('monitor type', '2D X-normal');
        set('x', monitor_x_m);
        set('y', y_m);
        set('y span', monitor_port_y_span_m);
        set('z', 0);

        addmodeexpansion;
        set('name', modeexp_name);
        set('monitor type', 'linear Y');
        setexpansion(modeexp_name, p_name);
        set('x', monitor_x_m);
        set('y', y_m);
        set('y span', monitor_port_y_span_m);
        set('mode selection', 'fundamental mode');
        if (multi_wavelength) {
            if (haveproperty('override global monitor settings')) { set('override global monitor settings', true); }
            if (haveproperty('use source limits')) { set('use source limits', true); }
            if (haveproperty('frequency points')) { set('frequency points', wl_points); }
        }
        set('z', 0);
    }
}

updatemodes;
